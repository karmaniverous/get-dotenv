{
  "author": "Jason Williscroft",
  "bin": {
    "getdotenv": "./dist/getdotenv.cli.mjs"
  },
  "bugs": {
    "url": "https://github.com/karmaniverous/get-dotenv/issues"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.1.0",
    "commander": "15.1.0",
    "dotenv": "^18.0.10",
    "execa": "^10.2.1",
    "fs-extra": "^11.4.1",
    "globby": "^16",
    "nanoid": "^6.0.2",
    "package-directory": "^8.2.0",
    "radash": "^12.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "description": "Process dotenv files in an arbitrary location & optionally populate environment variables.",
  "devDependencies": {
    "@aws-sdk/client-sts": "^3.1169.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "git-cliff": "^2.14.2",
    "globals": "^17.14.0",
    "jsonc-eslint-parser": "^3.3.0",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "npm-packlist": "^11.3.1",
    "prettier": "^3.10.1",
    "release-it": "^21.1.2",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.4",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.mjs"
      }
    },
    "./cliHost": {
      "import": {
        "types": "./dist/cliHost.d.ts",
        "default": "./dist/cliHost.mjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.mjs"
      }
    },
    "./plugins/aws": {
      "import": {
        "types": "./dist/plugins-aws.d.ts",
        "default": "./dist/plugins-aws.mjs"
      }
    },
    "./plugins/batch": {
      "import": {
        "types": "./dist/plugins-batch.d.ts",
        "default": "./dist/plugins-batch.mjs"
      }
    },
    "./plugins/init": {
      "import": {
        "types": "./dist/plugins-init.d.ts",
        "default": "./dist/plugins-init.mjs"
      }
    },
    "./plugins/cmd": {
      "import": {
        "types": "./dist/plugins-cmd.d.ts",
        "default": "./dist/plugins-cmd.mjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.mjs"
      }
    },
    "./env/overlay": {
      "import": {
        "types": "./dist/env-overlay.d.ts",
        "default": "./dist/env-overlay.mjs"
      }
    }
  },
  "files": [
    "dist",
    "getdotenv.config.json",
    "schema",
    "templates"
  ],
  "homepage": "https://github.com/karmaniverous/get-dotenv#readme",
  "keywords": [
    "cli",
    "configuration",
    "developer-tools",
    "development-environment",
    "devops",
    "dotenv-management",
    "environment-variables",
    "json",
    "nodejs",
    "typescript"
  ],
  "license": "BSD-3-Clause",
  "main": "dist/index.mjs",
  "name": "@karmaniverous/get-dotenv",
  "peerDependencies": {
    "@aws-sdk/client-sts": "^3.965.0",
    "esbuild": "*"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sts": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true,
      "releaseName": "${name.split('/').pop()}@${version}",
      "releaseNotes": "npx git-cliff --tag v${version} ${latestTag}..HEAD --strip header"
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run test",
        "npm run build",
        "npm run verify:types",
        "npm run verify:package",
        "npm run verify:bundle",
        "npm run verify:tarball"
      ],
      "after:bump": [
        "npx git-cliff --tag v${version} -o CHANGELOG.md",
        "git add CHANGELOG.md"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/karmaniverous/get-dotenv"
  },
  "scripts": {
    "generate:schema": "tsx tools/generate-schema.js",
    "build": "npm run generate:schema && rimraf dist && rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "baseline:record": "node tools/baseline-record.js",
    "cli": "tsx src/cli/getdotenv",
    "cli:dist": "node dist/getdotenv.cli.mjs",
    "changelog": "git-cliff -o CHANGELOG.md",
    "docs": "typedoc",
    "pack:dry": "npm pack --dry-run",
    "knip": "knip",
    "lint": "eslint . eslint.config.ts",
    "lint:fix": "eslint --fix . eslint.config.ts",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --preRelease",
    "test": "vitest run",
    "typecheck": "tsc",
    "verify:types": "node tools/verify-types.js",
    "verify:package": "node tools/verify-package.js",
    "verify:smoke": "node tools/smoke.js",
    "verify:bundle": "node tools/verify-bundle-imports.js",
    "verify:tarball": "node tools/verify-tarball.js"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "7.0.11"
}
